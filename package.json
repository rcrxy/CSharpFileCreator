{
  "name": "csharpfilecreator",
  "displayName": "C# File Creator",
  "description": "Quickly Create C# Files via the Right-Click Menu.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.cs",
    "workspaceContains:**/*.cshtml",
    "workspaceContains:**/*.razor"
  ],
  "main": "./out/index.js",
  "contributes": {
    "menus": {
      "explorer/context": [
        {
          "when": "explorerResourceIsFolder",
          "submenu": "csharpfilecreator",
          "group": "navigation"
        }
      ],
      "csharpfilecreator": [
        {
          "command": "csharpfilecreator.helloWorld"
        }
      ]
    },
    "submenus": [
      {
        "id": "csharpfilecreator",
        "label": "C# New File"
      }
    ],
    "commands": [
      {
        "title": "hello",
        "command": "csharpfilecreator.helloWorld"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.98.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "typescript": "^5.7.3",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
